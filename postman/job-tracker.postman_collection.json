          "name": "List old applications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"returns 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"contains applications array\", () => pm.expect(json.applications).to.be.an(\"array\"));",
                  "pm.test(\"only returns stale pending applications\", () => {",
                  "  json.applications.forEach(item => {",
                  "    pm.expect(item.status).to.eql(\"pending\");",
                  "    pm.expect(Date.now() - Date.parse(item.appliedAt)).to.be.above(30 * 24 * 60 * 60 * 1000);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
